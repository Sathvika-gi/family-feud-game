# Frontend Environment Variables (Vercel / Local)
# For local development with Vite proxy, leave empty or set to localhost:
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# For Vercel production deployment pointing to Azure App Service:
# VITE_BACKEND_URL=https://your-backend-app.azurewebsites.net
# VITE_WS_URL=wss://your-backend-app.azurewebsites.net/ws

# If using Azure Container Apps:
# VITE_BACKEND_URL=https://your-backend-app.<region>.azurecontainerapps.io
# VITE_WS_URL=wss://your-backend-app.<region>.azurecontainerapps.io/ws

# Admin / Host Console Protection (Supports one or multiple comma-separated passwords/PINs)
# Example multiple: VITE_ADMIN_PASSWORD=1234,admin,host2026
VITE_ADMIN_PASSWORD=1234,admin
