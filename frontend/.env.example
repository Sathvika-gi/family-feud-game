# Frontend Environment Variables (Vercel / Local)
# For local development with Vite proxy, leave empty or set to localhost:
VITE_BACKEND_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# For Vercel production deployment, set to your Railway service URL:
# VITE_BACKEND_URL=https://your-backend-service.up.railway.app
# VITE_WS_URL=wss://your-backend-service.up.railway.app/ws
